<% render '/**/Default.*' do %>

<h2><a href="/blog/">Blog</a> / <code><%= @item[:tag] %></code></h2>

<p>
  This is a list of all posts tagged with <code><%= @item[:tag] %></code>.
</p>

<div id="blog-archive">
  <% items_with_tag(@item[:tag]).sort_by {|i| Time.parse(i[:created_at].to_s)}.reverse.each do |post| %>
    <%= render '/components/post_in_list.html.erb', :post => post %>
  <% end %>
</div>

<% end %>