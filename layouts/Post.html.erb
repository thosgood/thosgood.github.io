<% render '/**/Default.*' do %>

<article>

  <div id="post-title-block">
    <% if @item[:part] != nil %>
    <h1 id="post-title">
      <a href="/blog/">Blog</a> / <%= @item[:title] %> [<%= @item[:part] %>]
    </h1>
    <% else %>
    <h1 id="post-title">
      <a href="/blog/">Blog</a> / <%= @item[:title] %>
    </h1>
    <% end %>

    <p id="post-date"><%= get_pretty_date(item) %></p>

    <%# Other posts in the same series %>
    <% if @item[:part] != nil %>
    <div id="post-other-parts">
      <i>Other posts in this series:</i>
      <% sorted_articles.reverse.each do |otherpost| %>
        <% if otherpost[:title] == @item[:title] %>
          <%= link_to_unless_current "#{otherpost[:part]}", otherpost.path %>
        <% end %>
      <% end %>
    </div>
    <% end %>

    <%# Tags %>
    <div id="post-tag-list">
      <%= tags_for(@item, base_url: '/blog/', separator: ", ") %>
    </div>
  </div>

  <%# Actual blog post content %>
  <div id="post-content">
    <%= yield %>
  </div>

  <%# giscus comments %>
  <script src="https://giscus.app/client.js"
          data-repo="thosgood/thosgood.github.io"
          data-repo-id="MDEwOlJlcG9zaXRvcnkxMTM2OTM5MjM="
          data-category="Comments"
          data-category-id="DIC_kwDOBsbU484CdW9A"
          data-mapping="title"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="light"
          data-lang="en"
          data-loading="lazy"
          crossorigin="anonymous"
          async>
  </script>
</article>
<% end %>


<!-- Render maths in comments -->
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.15.1/dist/contrib/auto-render.min.js" integrity="sha384-+XBljXPPiv+OzfbB3cVmLHf4hdUFHlWNZN5spNQ7rmHTXpd7WvJum6fIACpNNfIR" crossorigin="anonymous"></script>
<script type="text/javascript">
  $(window).bind("load", function() {
    renderMathInElement(document.getElementById('commento'), {
          delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false},
              {left: '\\(', right: '\\)', display: false},
              {left: '\\[', right: '\\]', display: true}
          ],
          throwOnError : false,
          fleqn : true
        });
  });
</script>
