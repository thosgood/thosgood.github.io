<nav id="top-navigation">
  <div id="navigation-name">
    <%= link_to_unless_current(@config[:full_name], '/', :class => 'navigation-link') %>
  </div>
  <div id="navigation-page-links">
    <%= link_to_unless_current('Research', '/research/', :class => 'navigation-link') %>
    <%= link_to_unless_current('Translations', '/translations/', :class => 'navigation-link') %>
    <%# We have to be a deal with the "Blog" link in a different way, since we want
        it to be marked as active even when we're on a subpage of the blog %>
    <% if (@item.path.include? "blog") %>
      <span class="active">Blog</span>
    <% else %>
      <%= link_to('Blog', '/blog/', :class => 'navigation-link') %>
    <% end %>
    <%= link_to_unless_current('CV', '/cv/', :class => 'navigation-link') %>
  </div>
</nav>
