<div>
  <div>
    <h3 id="<%= generate_post_link_id(post) %>">
      <% if post[:part] != nil %>
        <%= link_to "#{post[:title]} (#{post[:part]})", post.path, :class => "no-underline" %>
      <% else %>
        <%= link_to post[:title], post.path, :class => "no-underline" %>
      <% end %>
    </h3>

    <span>
      <!-- From lib/post_helper.rb -->
      <%= get_short_date(post) %>
    </span>
  </div>

  <article>
    <!-- From lib/post_helper.rb -->
    <%= get_post_before_fold(post) %>
  </article>

  <div>
    <%= tags_for(post, base_url: '/blog/', separator: "  ") %>
  </div>
</div>
