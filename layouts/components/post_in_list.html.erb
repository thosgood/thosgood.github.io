<div class="blog-archive-entry">
  <div>
    <h3 id="<%= generate_post_link_id(post) %>">
      <% if post[:part] != nil %>
        <%= link_to "#{post[:title]} [#{post[:part]}]", post.path %>
      <% else %>
        <%= link_to post[:title], post.path %>
      <% end %>
    </h3>

    <span>
      <!-- From lib/post_helper.rb -->
      <%= get_pretty_date(post) %>
    </span>
  </div>

  <article>
    <!-- From lib/post_helper.rb -->
    <%= get_post_before_fold(post) %>
  </article>

  <div class="tag-list">
    <%= tags_for(post, base_url: '/blog/', separator: "  ") %>
  </div>
</div>
